{
  "name": "opengraph-creator",
  "version": "0.1.3",
  "description": "Agent-first local Open Graph Creator studio and CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajikshank/opengraph-creator.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Rajikshank/opengraph-creator/issues"
  },
  "homepage": "https://github.com/Rajikshank/opengraph-creator#readme",
  "keywords": [
    "open-graph",
    "og-image",
    "social-preview",
    "codex",
    "claude-code",
    "opencode",
    "agent-skill"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opengraph-creator": "dist/index.js"
  },
  "files": [
    "dist",
    "codex-skill",
    "studio-dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir dist --declaration --emitDeclarationOnly false && node scripts/copy-studio-dist.mjs && node scripts/copy-bundled-workspace-deps.mjs"
  },
  "dependencies": {
    "@opengraph-creator/core": "0.1.3",
    "@opengraph-creator/render": "0.1.3",
    "fflate": "^0.8.3",
    "sharp": "^0.33.5"
  },
  "bundledDependencies": [
    "@opengraph-creator/core",
    "@opengraph-creator/render"
  ],
  "bundleDependencies": [
    "@opengraph-creator/core",
    "@opengraph-creator/render"
  ]
}
