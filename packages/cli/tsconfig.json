{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@graphforge/core": ["packages/core/dist/index.d.ts"],
      "@graphforge/render": ["packages/render/dist/index.d.ts"]
    },
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
