{
  "name": "@opengraph-creator/render",
  "version": "0.1.5",
  "description": "Renderer and raster export pipeline for OpenGraph Creator.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajikshank/opengraph-creator.git",
    "directory": "packages/render"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir dist --declaration --emitDeclarationOnly false"
  },
  "dependencies": {
    "@opengraph-creator/core": "0.1.5",
    "sharp": "^0.33.5"
  }
